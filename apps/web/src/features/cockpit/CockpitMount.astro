---
/**
 * The WASM mounting boundary.
 *
 * The Rust/WASM Cockpit takes over `#fleetscope-cockpit-canvas`. Nothing else in
 * the app writes into that element, so the renderer owns its DOM subtree
 * entirely and the Astro shell keeps owning everything around it.
 *
 * The transport strip, the Event Cursor readout, the phase navigation and the
 * Return-to-live control are DOM, not renderer: they speak in FleetScope's units
 * (Canonical Events), which the renderer deliberately does not know.
 */
import type { RenderManifest } from '@fleetscope/scenario-compiler';
import type { DemoPhase } from '../../lib/demo-phases';

interface Props {
  caseId: string;
  manifest: RenderManifest;
  main: string;
  subagentsJson: string;
  /** Every accepted caseSequence, in order. FleetScope's unit for unread. */
  caseSequences: readonly number[];
  phases: readonly DemoPhase[];
}
const { caseId, manifest, main, subagentsJson, caseSequences, phases } = Astro.props;
---

<section class="fs-cockpit">
  <header class="fs-cockpit__bar">
    <span
      class="fs-transport"
      data-transport-badge
      data-transport="idle"
      data-historical="false"
      role="status"
      aria-live="polite"
    >
      <span class="fs-transport__dot" aria-hidden="true"></span>
      <span data-transport-label>Recorded · at the latest event</span>
    </span>

    <span class="fs-cursor-readout" data-cursor-readout>
      Event <strong data-cursor-sequence>—</strong> of <span data-cursor-total>{caseSequences.length}</span>
    </span>

    <button type="button" class="fs-button fs-button--sm" data-return-to-live hidden>
      Return to live<span data-unread-count></span>
    </button>

    <span class="fs-cockpit__hint" style="margin-left:auto">
      <kbd>space</kbd> play/pause · <kbd>[</kbd>/<kbd>]</kbd> step · <kbd>g</kbd> latest ·
      <kbd>o</kbd> overview · <kbd>f</kbd> follow · <kbd>?</kbd> help
    </span>
  </header>

  {phases.length > 0 && (
    <nav aria-label="Case walkthrough" data-cockpit-expert hidden>
      <ol class="fs-phases">
        {phases.map((phase) => (
          <li>
            <button
              type="button"
              class="fs-phase"
              data-phase={phase.id}
              data-seek-sequence={phase.caseSequence}
              aria-current="false"
              title={phase.hint}
            >
              <span class="fs-phase__index" aria-hidden="true">{phase.index}</span>
              {phase.label}
            </button>
          </li>
        ))}
      </ol>
    </nav>
  )}

  <div
    id="fleetscope-cockpit-canvas"
    class="fs-cockpit__canvas"
    role="img"
    aria-label="Fleet Cockpit agent graph"
    aria-describedby="fs-cockpit-fallback"
    data-case-id={caseId}
  >
    <p class="fs-placeholder" id="fs-cockpit-fallback" data-cockpit-fallback>Loading Fleet Cockpit…</p>
  </div>

  <p class="fs-cockpit__hint" data-phase-hint>
    The graph is <strong>secondary evidence</strong>. Every decision it draws is recorded
    independently in the evidence rail and the Audit view.
  </p>

  <!--
    The compiled Case travels as inert JSON, not as executable script. Inlined at
    build time so the recorded demo needs no network after first load.
  -->
  <script type="application/json" data-cockpit-scene set:html={JSON.stringify({
    caseId,
    manifest,
    main,
    subagentsJson,
    caseSequences,
  })} />
</section>

<script>
  import { createCockpit, canonicalEventFor } from './lib/cockpit-adapter';
  import {
    acceptEvents,
    caseId as toCaseId,
    createCaseCursor,
    returnToLive,
    seekCursor,
    type CaseCursorState,
  } from '@fleetscope/domain';
  import type { RenderManifest, RenderManifestEntry } from '@fleetscope/scenario-compiler';

  interface SceneData {
    caseId: string;
    manifest: RenderManifest;
    main: string;
    subagentsJson: string;
    caseSequences: number[];
  }

  const sceneNode = document.querySelector<HTMLScriptElement>('[data-cockpit-scene]');
  const canvas = document.getElementById('fleetscope-cockpit-canvas');
  const fallback = document.querySelector<HTMLElement>('[data-cockpit-fallback]');

  if (sceneNode !== null && canvas !== null) {
    const scene = JSON.parse(sceneNode.textContent ?? '{}') as SceneData;
    void mount(scene);
  }

  /**
   * Load the generated wasm-bindgen glue.
   *
   * It is a build artifact in /public — outside Vite's module graph and outside
   * TypeScript's view of the project. A direct `import()` from this module does
   * NOT work in dev: Vite rewrites the request to `/wasm/cockpit.js?import` and
   * then refuses it, because a file in /public is copied verbatim and never
   * transformed. The import therefore has to originate from a script element the
   * bundler never sees, which is what this does. The module's shape is asserted
   * against the ABI afterwards, so a partial load fails by name rather than at
   * the first call site.
   */
  function loadRendererGlue(): Promise<void> {
    const scope = globalThis as Record<string, unknown>;
    if (scope['fleetscopeCockpit'] !== undefined) return Promise.resolve();

    return new Promise<void>((resolve, reject) => {
      const done = (event: Event): void => {
        window.removeEventListener('fleetscope:glue', done);
        const detail = (event as CustomEvent).detail as { ok: boolean; message?: string };
        if (detail.ok) resolve();
        else reject(new Error(detail.message ?? 'the renderer module failed to load'));
      };
      window.addEventListener('fleetscope:glue', done, { once: true });

      const loader = document.createElement('script');
      loader.type = 'module';
      loader.textContent = [
        "import('/wasm/cockpit.js')",
        '  .then(async (module) => {',
        '    await module.default();',
        '    globalThis.fleetscopeCockpit = module;',
        "    window.dispatchEvent(new CustomEvent('fleetscope:glue', { detail: { ok: true } }));",
        '  })',
        '  .catch((error) => {',
        "    window.dispatchEvent(new CustomEvent('fleetscope:glue', {",
        '      detail: { ok: false, message: String((error && error.message) || error) },',
        '    }));',
        '  });',
      ].join('\n');
      document.head.append(loader);
    });
  }

  async function mount(scene: SceneData): Promise<void> {
    // FleetScope owns the Event Cursor, the high-water mark and therefore the
    // canonical unread count. The renderer is never asked for any of them.
    let cursor: CaseCursorState = createCaseCursor(toCaseId(scene.caseId), scene.caseSequences);

    try {
      await loadRendererGlue();
    } catch (error) {
      // Say the real reason. Drawing a fake graph here would be exactly the
      // "UI invents behavior" failure the product forbids.
      degrade(
        'The Fleet Cockpit renderer could not be loaded (' +
          (error instanceof Error ? error.message : 'unknown error') +
          ').',
      );
      wireControls(null, scene, () => cursor, (next) => (cursor = next));
      render(null, cursor, scene.manifest);
      return;
    }

    const cockpit = createCockpit();
    if (!cockpit.available) {
      degrade(cockpit.unavailableReason ?? 'Fleet Cockpit unavailable.');
      wireControls(null, scene, () => cursor, (next) => (cursor = next));
      render(null, cursor, scene.manifest);
      return;
    }

    cockpit.load(scene.main, scene.subagentsJson, JSON.stringify(scene.manifest));
    fallback?.remove();

    wireControls(cockpit, scene, () => cursor, (next) => (cursor = next));

    document.querySelector('[data-return-to-live]')?.addEventListener('click', () => {
      // Order matters: every accepted event must already be projected before the
      // cursor moves to the edge, or the edge would omit accepted evidence.
      cursor = returnToLive(cursor, scene.caseSequences);
      cockpit.goLive();
      render(cockpit, cursor, scene.manifest);
    });

    // The renderer has its own transport (the operator can scrub inside the
    // canvas), so the shell follows it rather than assuming it is the only
    // thing that moves the view.
    let lastRendererIndex = -1;
    const poll = (): void => {
      const snapshot = cockpit.snapshot();
      if (snapshot !== null && snapshot.rendererEntryIndex !== lastRendererIndex) {
        lastRendererIndex = snapshot.rendererEntryIndex;
        const entry = canonicalEventFor(scene.manifest, snapshot.rendererEntryIndex);
        if (entry !== null) {
          cursor = snapshot.atEdge
            ? returnToLive(cursor, scene.caseSequences)
            : seekCursor(cursor, scene.caseSequences, entry.caseSequence);
        }
      }
      render(cockpit, cursor, scene.manifest);
      requestAnimationFrame(poll);
    };
    requestAnimationFrame(poll);

    // Exposed for the optional bounded live path: it appends canonical evidence
    // and the manifest delta together, never one without the other.
    (globalThis as Record<string, unknown>)['fleetscopeAppend'] = (
      mainTail: string,
      subagents: string,
      entries: RenderManifestEntry[],
    ): void => {
      cockpit.append(mainTail, subagents, JSON.stringify(entries));
      for (const entry of entries) {
        scene.caseSequences.push(entry.caseSequence);
        // The manifest the shell translates through must grow with the renderer,
        // or a cursor lookup for the new evidence would silently miss it.
        (scene.manifest.entries as RenderManifestEntry[]).push(entry);
      }
      (scene.manifest as { rendererEntryCount: number }).rendererEntryCount = entries.reduce(
        (total, entry) => total + entry.rendererEntryCount,
        scene.manifest.rendererEntryCount,
      );
      cursor = acceptEvents(cursor, scene.caseSequences);
      render(cockpit, cursor, scene.manifest);
    };
  }

  /** The renderer is gone; the evidence is not. Say exactly that. */
  function degrade(reason: string): void {
    if (fallback === null) return;
    fallback.textContent =
      reason +
      ' Recorded evidence is still complete in the evidence rail, the Case Workspace and the Audit view.';
  }

  /**
   * Wire every control that moves the Event Cursor.
   *
   * Delegated from `document` on purpose: the bounded live proof appends evidence
   * rows after this runs, and a per-element listener bound at mount time would
   * leave those rows inert.
   */
  function wireControls(
    cockpit: ReturnType<typeof createCockpit> | null,
    scene: SceneData,
    read: () => CaseCursorState,
    write: (next: CaseCursorState) => void,
  ): void {
    const seekTo = (caseSequence: number, source: HTMLElement | null): void => {
      write(seekCursor(read(), scene.caseSequences, caseSequence));
      // Always through the Render Manifest — never `caseSequence / last`.
      cockpit?.seekToCaseSequence(caseSequence);

      if (source !== null && source.hasAttribute('data-evidence-marker')) {
        for (const other of document.querySelectorAll('[data-evidence-marker]')) {
          other.setAttribute('aria-current', String(other === source));
        }
      }
      if (source !== null && source.hasAttribute('data-phase')) {
        for (const other of document.querySelectorAll('[data-phase]')) {
          other.setAttribute('aria-current', String(other === source));
        }
        const hint = document.querySelector<HTMLElement>('[data-phase-hint]');
        if (hint !== null) hint.textContent = source.getAttribute('title') ?? hint.textContent;
      }
      render(cockpit, read(), scene.manifest);
    };

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      const marker = target?.closest<HTMLElement>('[data-evidence-marker]');
      if (marker !== null && marker !== undefined) {
        seekTo(Number(marker.dataset['caseSequence'] ?? 0), marker);
        return;
      }
      const seeker = target?.closest<HTMLElement>('[data-seek-sequence]');
      if (seeker !== null && seeker !== undefined && seeker.dataset['seekSequence'] !== '') {
        seekTo(Number(seeker.dataset['seekSequence'] ?? 0), seeker);
        return;
      }
      const agent = target?.closest<HTMLElement>('[data-agent-node]');
      if (agent !== null && agent !== undefined) {
        for (const other of document.querySelectorAll('[data-agent-node]')) {
          other.setAttribute('aria-current', String(other === agent));
        }
        // Selecting a node in the renderer is optional in the ABI. Where it is
        // absent nothing is faked; the Event Cursor still moves to that agent's
        // last recorded action, which is a real capability.
        cockpit?.select(agent.dataset['agentNode'] ?? '');
        const sequence = agent.dataset['caseSequence'] ?? '';
        if (sequence !== '') seekTo(Number(sequence), agent);
      }
    });

    // The Decision Evidence drawer asks; the Cockpit decides how to get there.
    document.addEventListener('fleetscope:seek-request', (event) => {
      const detail = (event as CustomEvent).detail as { caseSequence: number };
      seekTo(detail.caseSequence, null);
    });
  }

  /** The last announced cursor state, so identical frames stay silent. */
  let lastRenderSignature = '';

  /**
   * Paint the FleetScope-owned readouts.
   *
   * Historical evidence must never read as live, an unknown value must never
   * render as zero, and the event count an operator reads is 1-based — a 60-event
   * Case ends at "Event 60 of 60", never "Event 59 of 59".
   */
  function render(
    cockpit: ReturnType<typeof createCockpit> | null,
    cursor: CaseCursorState,
    manifest: RenderManifest,
  ): void {
    const snapshot = cockpit?.snapshot() ?? null;
    const badge = document.querySelector<HTMLElement>('[data-transport-badge]');
    const label = document.querySelector<HTMLElement>('[data-transport-label]');
    const sequence = document.querySelector<HTMLElement>('[data-cursor-sequence]');
    const total = document.querySelector<HTMLElement>('[data-cursor-total]');
    const button = document.querySelector<HTMLElement>('[data-return-to-live]');
    const unread = document.querySelector<HTMLElement>('[data-unread-count]');

    const historical = !cursor.atEdge;
    const transport = snapshot?.transport ?? (historical ? 'history' : 'idle');

    if (badge !== null) {
      badge.dataset['transport'] = transport;
      badge.dataset['historical'] = String(historical);
    }
    if (label !== null) {
      label.textContent = historical
        ? 'Historical · recorded evidence, nothing is executing'
        : transport === 'playing'
          ? 'Playing · recorded evidence'
          : 'Recorded · at the latest event';
    }
    if (sequence !== null) {
      sequence.textContent = cursor.eventCursor < 0 ? '—' : String(cursor.eventCursor + 1);
    }
    if (total !== null) {
      total.textContent = String(cursor.caseHighWaterMark + 1);
    }
    if (button !== null) {
      button.hidden = !historical;
    }
    if (unread !== null) {
      // Canonical unread is FleetScope's count of accepted Canonical Events after
      // the cursor — never the number of renderer items, which is a different
      // unit entirely.
      unread.textContent = cursor.canonicalUnread > 0 ? ` · +${cursor.canonicalUnread} new` : '';
    }

    const entry = snapshot === null ? null : canonicalEventFor(manifest, snapshot.rendererEntryIndex);
    // The poll runs every animation frame; the cursor changes far less often.
    // Announcing every frame would make the evidence rail fight the operator for
    // the scroll position and would spam any listener with identical state.
    const signature = `${cursor.eventCursor}|${transport}|${historical}|${entry?.eventId ?? ''}`;
    if (signature === lastRenderSignature) return;
    lastRenderSignature = signature;
    document.dispatchEvent(
      new CustomEvent('fleetscope:cursor', { detail: { cursor, entry, transport } }),
    );
  }
</script>
