---
/**
 * Primary navigation.
 *
 * Two destinations, because the product has two: the developer's own sessions,
 * and how to get them there. The enterprise surfaces (Cases, Catalog,
 * Approvals, Cockpit, Audit) are a future direction rather than this product's
 * golden path. They are preserved in `src/deferred/` and are NOT built: keeping
 * them out of the primary nav was not enough, because a static build emits every
 * page under `src/pages/` and the public deployment then served them by URL.
 * See src/deferred/README.md and docs/archive/README.md.
 */
interface Props {
  path: string;
  /** Shown only on the deferred enterprise routes, as an explicit label. */
  legacy?: boolean;
}
const { path, legacy = false } = Astro.props;

const links = [
  { href: '/sessions/', label: 'Sessions', section: '/sessions' },
  { href: '/docs/', label: 'Setup', section: '/docs' },
];

const isCurrent = (link: { href: string; section?: string }): boolean => {
  const base = link.section ?? link.href;
  return path === base || path.startsWith(base + '/');
};
---

<nav class="fs-nav" aria-label="Primary">
  <a class="fs-nav__brand" href="/">
    <span class="fs-nav__brand-name">FleetScope</span>
    <span class="fs-nav__brand-sub">Local Agent Viewer</span>
  </a>
  <div class="fs-nav__links">
    {links.map((link) => (
      <a class="fs-nav__link" href={link.href} aria-current={isCurrent(link) ? 'page' : undefined}>
        {link.label}
      </a>
    ))}
  </div>
  <div class="fs-nav__env">
    {legacy ? (
      <span class="fs-mode" data-tone="neutral" title="An earlier enterprise surface, kept for reference. It is not part of the local Agent Viewer.">
        Enterprise preview
      </span>
    ) : (
      <span class="fs-mode" data-tone="neutral" title="Gemini / Google ADK sessions captured on this machine.">
        Gemini · Google ADK
      </span>
    )}
  </div>
</nav>
