---
/**
 * The Decision Evidence drawer.
 *
 * Decision Evidence is NOT chain-of-thought. It is the set of inspectable
 * recorded facts behind a decision: which events, which actor, which policy,
 * which authoritative result. `rationale` is a concise operator-safe summary and
 * is never sourced from, or presented as, private model reasoning.
 *
 * It reads the Render Manifest's semantic outcome, so a policy denial reads
 * "Identity denied" even where the graph has to draw it with the same error
 * styling it uses for a crash.
 */
import type { RenderManifest } from '@fleetscope/scenario-compiler';
import type { CanonicalEvent } from '@fleetscope/event-schema';

interface Props {
  manifest: RenderManifest;
  events: readonly CanonicalEvent[];
  streamRevision: string;
  projectorVersion: string;
  stateHash: string;
}
const { manifest, events, streamRevision, projectorVersion, stateHash } = Astro.props;

const byEventId = new Map(events.map((event) => [event.eventId, event]));

/** Only what an operator may see. Payloads are already redacted upstream. */
const rows = manifest.entries.map((entry) => {
  const event = byEventId.get(entry.eventId);
  return {
    eventId: entry.eventId,
    caseSequence: entry.caseSequence,
    domain: entry.domain,
    outcome: entry.outcome,
    label: entry.label,
    type: event?.type ?? 'unknown',
    sessionId: event?.sessionId ?? null,
    actor: event === undefined ? 'unknown' : `${event.actor.kind}:${event.actor.id}`,
    at: event?.sourceTime ?? null,
    evidenceEventIds: entry.evidenceEventIds,
    rendered: entry.rendererEntryCount,
  };
});
---

<section class="fs-card" aria-labelledby="fs-evidence-heading">
  <header class="fs-drawer__head">
    <h2 id="fs-evidence-heading">Decision Evidence</h2>
    <p class="fs-muted">
      Recorded facts behind each decision. Not model reasoning — FleetScope records
      no hidden thought and reconstructs none.
    </p>
  </header>

  <dl class="fs-kv fs-kv--tight">
    <dt>Stream revision</dt><dd class="fs-mono">{streamRevision}</dd>
    <dt>Projector version</dt><dd class="fs-mono">{projectorVersion}</dd>
    <dt>Terminal state hash</dt><dd class="fs-mono">{stateHash}</dd>
    <dt>Renderer entries</dt><dd class="fs-mono">{manifest.rendererEntryCount}</dd>
  </dl>

  <p class="fs-muted fs-note">
    Given the same canonical stream revision, event prefix and projector version,
    FleetScope reconstructs the same Observable Case State.
  </p>

  <div class="fs-drawer__body" data-evidence-body>
    <ul class="fs-evidence-list">
      {rows.map((row) => (
        <li
          class="fs-evidence-row"
          data-evidence-marker={row.eventId}
          data-case-sequence={row.caseSequence}
          data-event-id={row.eventId}
          data-outcome={row.outcome}
          tabindex="0"
          role="button"
          aria-current="false"
        >
          <span class="fs-evidence-row__seq fs-mono">#{row.caseSequence}</span>
          <span class="fs-badge" data-outcome={row.outcome}>
            <span class="fs-badge__glyph" aria-hidden="true">
              {row.outcome === 'succeeded' ? '✓'
                : row.outcome === 'sanitized' ? '≈'
                : row.outcome === 'flagged' ? '!'
                : row.outcome === 'denied' ? '⊘'
                : row.outcome === 'blocked' ? '✗'
                : row.outcome === 'failed' ? '✗'
                : row.outcome === 'pending' ? '…'
                : '·'}
            </span>
            {row.outcome}
          </span>
          <span class="fs-evidence-row__label">{row.label}</span>
          <span class="fs-evidence-row__meta fs-mono">
            {row.domain} · {row.type} · {row.sessionId ?? 'case-level'} · {row.actor}
            {row.rendered === 0 && <> · not drawn in the graph</>}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Keep the selected row in view when the Cockpit cursor moves, so scrubbing the
  // graph and reading the evidence stay in step.
  document.addEventListener('fleetscope:cursor', (event) => {
    const detail = (event as CustomEvent).detail as { entry: { eventId: string } | null };
    if (detail.entry === null) return;
    const row = document.querySelector<HTMLElement>(
      `[data-evidence-marker="${CSS.escape(detail.entry.eventId)}"]`,
    );
    if (row === null) return;
    for (const other of document.querySelectorAll('[data-evidence-marker]')) {
      other.setAttribute('aria-current', String(other === row));
    }
    row.scrollIntoView({ block: 'nearest' });
  });
</script>
