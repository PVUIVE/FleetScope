---
import SectionHeader from './SectionHeader.astro';
import StatusLabel from './StatusLabel.astro';
import type { LandingData } from '../../lib/landing-data';

/**
 * 03 — Durable context (DESIGN.md §18).
 *
 * The fact, its source event and its recall event are read out of the recorded
 * Case. Nothing illustrative is invented here: if the record holds no durable
 * fact, the section says so rather than showing a plausible one.
 */
interface Props {
  data: LandingData;
}
const { data } = Astro.props;

const fact = data.memoryFacts[0] ?? null;
const sessionIndex = (sessionId: string | null): string => {
  const found = data.sessions.findIndex((session) => session.sessionId === sessionId);
  return found < 0 ? '—' : `Session ${String(found + 1).padStart(2, '0')}`;
};
---

<section class="fs-l-sec" id="context" aria-labelledby="fs-l-context-title">
  <div class="fs-l-block">
    <SectionHeader num="02" label="Persistent context" id="fs-l-context-title">
      <Fragment slot="headline">Context survives<br />the session.</Fragment>
      <p class="fs-l-lede">
        A Runtime Session ends. The durable fact it wrote does not — it is recalled in a
        later session with the event that produced it still attached.
      </p>
    </SectionHeader>

    {fact === null ? (
      <p class="fs-l-note" style="margin-top:32px">
        This Case recorded no durable memory fact.
      </p>
    ) : (
      <div class="fs-l-ctx" style="margin-top:44px" data-rise data-context>
        <div class="fs-l-ctx__col">
          <p class="fs-l-label">{sessionIndex(fact.sessionId)} · written</p>
          <div class="fs-l-fact" style="margin-top:14px">
            <p class="fs-l-mono" style="margin:0">{fact.reference}</p>
            <p class="fs-l-fact__body">{fact.summary}</p>
          </div>
          <dl class="fs-l-kv">
            <dt>Source</dt>
            <dd>{fact.eventId}</dd>
            <dt>Sequence</dt>
            <dd>{fact.caseSequence}</dd>
            {fact.sensitivity !== null && (
              <>
                <dt>Sensitivity</dt>
                <dd>{fact.sensitivity}</dd>
              </>
            )}
            <dt>Scope</dt>
            <dd>{data.memoryScope}</dd>
          </dl>
        </div>

        <div class="fs-l-ctx__wire" aria-hidden="true">
          <span class="fs-l-token" data-token></span>
        </div>

        <div class="fs-l-ctx__col">
          <p class="fs-l-label">
            {fact.recalled === null ? 'Not recalled in the record' : `${sessionIndex(fact.recalled.sessionId)} · recalled`}
          </p>
          {fact.recalled === null ? (
            <p class="fs-l-note" style="margin-top:14px">
              The record shows this fact written but never recalled.
            </p>
          ) : (
            <>
              <div class="fs-l-fact" style="margin-top:14px">
                <p class="fs-l-mono" style="margin:0">{fact.reference}</p>
                <p class="fs-l-fact__body">{fact.summary}</p>
              </div>
              <dl class="fs-l-kv">
                <dt>Recall</dt>
                <dd>{fact.recalled.eventId}</dd>
                <dt>Sequence</dt>
                <dd>{fact.recalled.caseSequence}</dd>
                {fact.usedBy !== null && (
                  <>
                    <dt>Used by</dt>
                    <dd>{fact.usedBy}</dd>
                  </>
                )}
              </dl>
            </>
          )}
        </div>
      </div>
    )}

    {data.memoryRejected !== null && (
      <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:28px;padding-top:24px;border-top:1px solid var(--fs-border)" data-rise>
        <StatusLabel kind="control" value="rejected" label="Memory rejected" />
        <p class="fs-l-note" style="margin:0">
          Not everything an agent proposes to remember is kept.
          {data.memoryRejected.detail !== null && ` ${data.memoryRejected.detail}.`}
          <span class="fs-l-mono"> {data.memoryRejected.eventId}</span>
        </p>
      </div>
    )}
  </div>
</section>
