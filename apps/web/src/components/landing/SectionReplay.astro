---
import SectionHeader from './SectionHeader.astro';
import type { LandingData } from '../../lib/landing-session';

/**
 * 05 — Replay the run without rerunning it.
 *
 * Dragging the marker backwards re-derives the view from a PREFIX of the same
 * recorded events. That is exactly what the product does: no model call, no
 * tool call, no request of any kind. The section says so in as many words,
 * because a replay that quietly re-executed would be the worst bug this
 * product could have.
 */
interface Props {
  data: LandingData;
}
const { data } = Astro.props;
const marks = data.spine.slice(0, 7);
---

<section class="fs-l-sec" aria-labelledby="fs-l-replay-title" data-replay>
  <SectionHeader num="05" label="Historical inspection" id="fs-l-replay-title">
    <span slot="headline">Replay the run without rerunning it.</span>
    <p class="fs-l-lede">
      Move backwards through the session and the graph, the timeline and the details all rewind
      together. Nothing executes: the view is re-derived from the events already recorded.
    </p>
  </SectionHeader>

  <div class="fs-d-replay">
    <ol class="fs-d-marks" role="group" aria-label="Positions in the recorded run">
      {marks.map((row, index) => (
        <li>
          <button
            type="button"
            class="fs-d-mark"
            data-replay-mark
            data-index={index}
            aria-pressed={index === marks.length - 1 ? 'true' : 'false'}
          >
            <span class="fs-d-mark__n">{String(index + 1).padStart(2, '0')}</span>
            <span class="fs-d-mark__l">{row.toolName ?? row.model ?? row.label}</span>
          </button>
        </li>
      ))}
    </ol>

    <div class="fs-d-replay__state" data-replay-state data-historical="false">
      <p class="fs-d-replay__badge" data-replay-badge>LIVE</p>
      <p class="fs-d-replay__note" data-replay-note>At the latest recorded event.</p>
      <dl class="fs-d-kv">
        <dt>Event</dt><dd data-replay-seq>{marks[marks.length - 1]?.sequence ?? 0}</dd>
        <dt>Agent</dt><dd data-replay-agent>{marks[marks.length - 1]?.agentId ?? 'Unknown'}</dd>
        <dt>Executing</dt><dd data-replay-exec>nothing</dd>
      </dl>
    </div>
  </div>

  <script type="application/json" data-replay-payload set:html={JSON.stringify(
    marks.map((row) => ({
      sequence: row.sequence,
      agent: row.agentId ?? 'Unknown',
      label: row.toolName ?? row.model ?? row.label,
    })),
  )} />
</section>
