---
import StatusLabel from './StatusLabel.astro';
import type { CorridorState } from '../../lib/landing-data';

/**
 * One control boundary, drawn as a corridor (DESIGN.md §19).
 *
 * Governance is shown by behaviour rather than by a label: when the selected
 * outcome is a denial the request stops at the gate and the downstream leg is
 * not drawn at all. Both outcomes are recorded events — the switch selects
 * between two things that happened, it does not simulate a third.
 */
interface Props {
  id: string;
  num: string;
  name: string;
  source: string;
  states: readonly CorridorState[];
}
const { id, num, name, source, states } = Astro.props;
const initial = states[0];
---

<article class="fs-l-gate" id={id} data-gate data-active="false">
  <div class="fs-l-gate__head">
    <span class="fs-l-gate__n">{num}</span>
    <h3 style="margin:0">{name}</h3>
  </div>
  <p class="fs-l-note">
    {states.length > 1
      ? 'Two recorded outcomes. Select either one.'
      : 'The recorded outcome of this control.'}
  </p>

  {/* The recorded facts behind each outcome, so switching reads them off the
      record rather than reconstructing a claim in script. */}
  {states.map((state) => (
    <script
      type="application/json"
      data-gate-state={state.key}
      set:html={JSON.stringify({
        eventId: state.eventId,
        detail: state.detail,
        policy: state.policy,
        target: state.target,
      })}
    />
  ))}

  <div class="fs-l-gate__switch" role="group" aria-label={`${name} outcome`}>
    {states.map((state, index) => (
      <button
        type="button"
        data-corridor-state={state.key}
        aria-pressed={index === 0 ? 'true' : 'false'}
      >{state.label}</button>
    ))}
  </div>

  <svg class="fs-l-gate__diagram" viewBox="0 0 240 214" role="img" aria-labelledby={`${id}-title`}>
    <title id={`${id}-title`}>
      {`${source} reaches ${name}. The recorded decision determines whether the request continues.`}
    </title>

    <rect class="fs-l-flow__box" x="50" y="4" width="140" height="30" />
    <text class="fs-l-flow__t" x="120" y="23">{source.toUpperCase()}</text>

    <path class="fs-l-flow__line" d="M120 34 L120 70" marker-end="" data-flow="in" />
    <path class="fs-l-flow__line" d="M113 62 L120 71 L127 62" data-flow="in-head" />

    <rect class="fs-l-flow__box fs-l-flow__box--gate" x="50" y="72" width="140" height="36" />
    <text class="fs-l-flow__t" x="120" y="94">{name.toUpperCase()}</text>

    <text
      class="fs-l-flow__t"
      x="120"
      y="128"
      data-flow-outcome
      style="letter-spacing:0.14em"
    >{initial?.badge.toUpperCase() ?? ''}</text>

    <path class="fs-l-flow__line fs-l-flow__line--blue" d="M120 136 L120 172" data-flow="out" />
    <path class="fs-l-flow__line fs-l-flow__line--blue" d="M113 164 L120 173 L127 164" data-flow="out-head" />
    <g data-flow="stop" style="opacity:0">
      <path class="fs-l-flow__stop" d="M110 142 L130 162" />
      <path class="fs-l-flow__stop" d="M130 142 L110 162" />
    </g>

    <rect class="fs-l-flow__box" x="50" y="176" width="140" height="30" data-flow="target" />
    <text class="fs-l-flow__t" x="120" y="195" data-flow-target>
      {initial?.target.toUpperCase() ?? ''}
    </text>

    <circle class="fs-l-flow__pulse" r="3.5" cx="120" cy="34" data-flow-pulse style="opacity:0" />
  </svg>

  <div class="fs-l-gate__foot">
    {/* Every recorded outcome's badge is rendered once; the switch reveals one.
        The status vocabulary stays server-resolved, never rebuilt in script. */}
    {states.map((state, index) => (
      <span data-corridor-badge={state.key} hidden={index !== 0}>
        <StatusLabel kind="control" value={state.badge} />
      </span>
    ))}
    <span class="fs-l-mono" data-corridor-evt>{initial?.eventId ?? ''}</span>
  </div>
  <p class="fs-l-note" style="margin-top:12px" data-corridor-detail>{initial?.detail ?? ''}</p>
  <p class="fs-l-mono" style="margin-top:8px" data-corridor-policy>{initial?.policy ?? ''}</p>
</article>
