---
import SectionHeader from './SectionHeader.astro';
import StatusLabel from './StatusLabel.astro';
import type { LandingData } from '../../lib/landing-data';

/**
 * 10 — Product surfaces (DESIGN.md §26).
 *
 * Five structural cells, each carrying a real fragment of the surface it names
 * rather than an icon. No generic feature cards.
 */
interface Props {
  data: LandingData;
}
const { data } = Astro.props;
---

<section class="fs-l-sec" id="surfaces" aria-labelledby="fs-l-surfaces-title">
  <div class="fs-l-block" style="padding-bottom:48px">
    <SectionHeader num="09" label="The control plane" id="fs-l-surfaces-title">
      <Fragment slot="headline">One operating layer<br />for the entire fleet.</Fragment>
    </SectionHeader>
  </div>

  <div class="fs-l-cells fs-l-surfaces">
    <a class="fs-l-cell fs-l-surface" href="/catalog">
      <p class="fs-l-surface__n">01</p>
      <h3>Agent Catalog</h3>
      <p class="fs-l-note">Discover approved agents.</p>
      <div class="fs-l-frag">
        <div class="fs-l-frag__row">
          <span class="fs-l-mono">{data.agentVersionRef}</span>
          <StatusLabel kind="agent" value={data.agentApprovalState} />
        </div>
        {data.agentOwner !== null && (
          <div class="fs-l-frag__row"><span>Owner</span><span>{data.agentOwner}</span></div>
        )}
      </div>
    </a>

    <a class="fs-l-cell fs-l-surface" href={`/cases/${data.caseId}`}>
      <p class="fs-l-surface__n">02</p>
      <h3>Case Workspace</h3>
      <p class="fs-l-note">Follow long-running business work.</p>
      <div class="fs-l-frag">
        <div class="fs-l-frag__row">
          <span class="fs-l-mono">{data.caseId}</span>
          <span>{data.milestoneCount} milestones</span>
        </div>
        <div class="fs-l-frag__row"><span>Owner</span><span>{data.owner}</span></div>
      </div>
    </a>

    <a class="fs-l-cell fs-l-surface" href="/approvals">
      <p class="fs-l-surface__n">03</p>
      <h3>Approvals</h3>
      <p class="fs-l-note">Authorize sensitive actions.</p>
      <div class="fs-l-frag">
        {data.approvalOpened === null ? (
          <div class="fs-l-frag__row"><span>No approval recorded</span></div>
        ) : (
          <>
            <div class="fs-l-frag__row">
              <span class="fs-l-mono">{data.approvalOpened.eventId}</span>
              <StatusLabel kind="approval" value={data.approvalResolved?.decision ?? 'pending'} />
            </div>
            {data.approvalResolved?.approver != null && (
              <div class="fs-l-frag__row"><span>Approver</span><span>{data.approvalResolved.approver}</span></div>
            )}
          </>
        )}
      </div>
    </a>

    <a class="fs-l-cell fs-l-surface" href={`/cockpit/${data.caseId}`}>
      <p class="fs-l-surface__n">04</p>
      <h3>Fleet Cockpit</h3>
      <p class="fs-l-note">Investigate and intervene.</p>
      <div class="fs-l-frag">
        <div class="fs-l-frag__row"><span>Tool calls</span><span>{data.toolCallCount}</span></div>
        <div class="fs-l-frag__row"><span>Agents</span><span>{data.agentRoles.length}</span></div>
      </div>
    </a>

    <a class="fs-l-cell fs-l-surface" href={`/audit/${data.caseId}`}>
      <p class="fs-l-surface__n">05</p>
      <h3>Audit</h3>
      <p class="fs-l-note">Reconstruct every decision.</p>
      <div class="fs-l-frag">
        <div class="fs-l-frag__row"><span>Events</span><span>{data.eventCount}</span></div>
        <div class="fs-l-frag__row"><span>Prefix hashes</span><span>{data.prefixHashCount}</span></div>
      </div>
    </a>
  </div>
</section>
