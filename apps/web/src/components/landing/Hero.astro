---
import type { LandingData } from '../../lib/landing-session';
import { formatDuration } from '../../lib/format';

/**
 * 01 — Hero.
 *
 * The Execution Spine: the run drawn as one vertical line, agent → model →
 * tool → handoff → tool → error → result. It replaces the old Case Orbit, whose
 * seven governed systems belonged to a product this one no longer is.
 *
 * Every node is a real event from the recorded run. Nothing here is a mock-up.
 */
interface Props {
  data: LandingData;
}
const { data } = Astro.props;

const spine = data.spine.slice(0, 7);
const start = data.session.startedAt;

const kindOf = (type: string): string => {
  if (type.startsWith('model')) return 'MODEL';
  if (type.startsWith('tool')) return 'TOOL';
  if (type === 'agent.handoff') return 'HANDOFF';
  if (type === 'error') return 'ERROR';
  return 'SESSION';
};

const offset = (iso: string): string => {
  if (start === null) return '';
  const ms = Date.parse(iso) - Date.parse(start);
  return Number.isFinite(ms) && ms >= 0 ? `+${(ms / 1000).toFixed(2)}s` : '';
};
---

<section class="fs-l-sec fs-l-hero" aria-labelledby="fs-l-hero-title" data-hero>
  <!--
    The node field. Decoration only, behind everything: the headline, the CTAs
    and the Execution Spine all sit above it. It is mounted by script and stays
    empty under reduced motion, so nothing here depends on it.
  -->
  <div class="fs-l-hero__field" id="fs-l-field" data-on="false" aria-hidden="true"></div>

  <div class="fs-l-hero__grid">
    <div>
      <h1 id="fs-l-hero-title">
        <span class="fs-l-reveal"><span>See what your</span></span>
        <span class="fs-l-reveal"><span><span class="fs-l-blue">agents</span> are doing.</span></span>
      </h1>
      <p class="fs-l-hero__sub" data-rise>
        FleetScope turns local Gemini/ADK sessions into a live execution graph —
        agents, tools, handoffs, errors, and timeline included.
      </p>
      <div class="fs-l-ctas" data-rise>
        <a class="fs-l-btn fs-l-btn--metal" href="/sessions/" data-metal>
          Open Agent Viewer
          <span class="fs-l-btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="fs-l-btn fs-l-btn--ghost" href="/docs/">Setup in two commands</a>
      </div>
      <div class="fs-d-term" data-rise>
        {['fleetscope watch', 'python examples/vendor_agent.py'].map((command) => (
          <button
            type="button"
            class="fs-d-term__cmd"
            data-copy-command={command}
            aria-label={`Copy command: ${command}`}
          >
            <span class="fs-d-term__prompt" aria-hidden="true">$</span>
            <code>{command}</code>
            <span class="fs-d-term__hint" aria-hidden="true" data-copy-hint>Copy</span>
          </button>
        ))}
      </div>
    </div>

    <div class="fs-l-hero__scene">
      <ol class="fs-d-spine" aria-label="A recorded Gemini / Google ADK run">
        {spine.map((row, index) => (
          <li class="fs-d-spine__row" data-kind={kindOf(row.type)} data-node style={`--i:${index}`}>
            <span class="fs-d-spine__t">{offset(row.timestamp)}</span>
            <span class="fs-d-spine__k">{kindOf(row.type)}</span>
            <span class="fs-d-spine__l">{row.toolName ?? row.model ?? row.label}</span>
            <span class="fs-d-spine__a">{row.agentId ?? ''}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <div class="fs-l-strip">
    <span><span class="fs-l-strip__dot" aria-hidden="true"></span><strong>{data.name}</strong></span>
    <span>{data.framework === 'google-adk' ? 'Gemini · Google ADK' : data.framework} {data.frameworkVersion}</span>
    <span><strong>{data.session.eventCount}</strong> events</span>
    <span><strong>{data.agents.length}</strong> agents</span>
    <span><strong>{data.session.toolCallCount}</strong> tool calls</span>
    <span><strong>{data.session.errorCount}</strong> failures</span>
    <span>{formatDuration(data.session.durationMs)}</span>
  </div>
</section>
