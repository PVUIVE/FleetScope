---
import SectionHeader from './SectionHeader.astro';
import type { LandingData } from '../../lib/landing-data';

/**
 * 09 — Audit (DESIGN.md §25).
 *
 * The Case Spine's last state: every evidence dot the page has shown aligns into
 * one vertical trail, then resolves to the three values an auditor can check the
 * whole Case against.
 */
interface Props {
  data: LandingData;
}
const { data } = Astro.props;

const digest = `${data.terminalStateHash.slice(0, 10)}…${data.terminalStateHash.slice(-6)}`;
---

<section class="fs-l-sec" id="audit" aria-labelledby="fs-l-audit-title">
  <div class="fs-l-block">
    <div class="fs-l-audit">
      <div>
        <SectionHeader num="08" label="Audit" id="fs-l-audit-title">
          <Fragment slot="headline">Every Case<br />leaves a record.</Fragment>
          <p class="fs-l-lede">
            Not a log of what the interface displayed — the Canonical Events the Case was
            rebuilt from, and the hash of the state they produce.
          </p>
        </SectionHeader>
        <a class="fs-l-btn fs-l-btn--primary" href={`/audit/${data.caseId}`} style="margin-top:32px">
          View {data.caseId} audit
          <span class="fs-l-btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <div data-rise>
        <div class="fs-l-spine" data-audit-spine>
          <span class="fs-l-spine__fill" data-spine-fill aria-hidden="true"></span>
          {data.spine.map((node) => (
            <div class="fs-l-ev" data-tone={node.tone} data-audit-node>
              <p class="fs-l-ev__label">{node.label}</p>
              <p class="fs-l-ev__meta">{node.eventId} · seq {node.caseSequence}</p>
            </div>
          ))}
        </div>

        <div class="fs-l-resolve" style="margin-top:28px">
          <div class="fs-l-resolve__row">
            <p class="fs-l-resolve__k">Stream revision</p>
            <p class="fs-l-resolve__v">{data.eventCount}</p>
          </div>
          <div class="fs-l-resolve__row">
            <p class="fs-l-resolve__k">Projector version</p>
            <p class="fs-l-resolve__v">{data.projectorVersion}</p>
          </div>
          <div class="fs-l-resolve__row">
            <p class="fs-l-resolve__k">Terminal state hash</p>
            <p class="fs-l-resolve__v">{digest}</p>
          </div>
        </div>

        <p class="fs-l-note" style="margin-top:16px">
          {data.prefixHashCount} prefix hashes are recorded alongside it, so any earlier
          position can be checked the same way. Agent Version {data.agentVersionRef}.
        </p>
      </div>
    </div>
  </div>
</section>
