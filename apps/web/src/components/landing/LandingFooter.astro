---
/**
 * 12 — Footer.
 *
 * Technology is credibility information here and nowhere else (DESIGN.md §39):
 * small, at the bottom, never a hero claim and never a brand-coloured badge.
 */
interface Props {
  caseId: string;
  liveMode: boolean;
}
const { caseId, liveMode } = Astro.props;
---

<footer class="fs-l-footer">
  <div>
    <p style="margin:0;font-weight:700;color:var(--fs-fg);font-size:13px">FleetScope</p>
    <p style="margin:4px 0 0">The control plane for long-running agent operations.</p>
  </div>
  <nav aria-label="Product surfaces" style="display:flex;flex-wrap:wrap;gap:8px 20px">
    <a href="/catalog">Agent Catalog</a>
    <a href={`/cases/${caseId}`}>Case Workspace</a>
    <a href="/approvals">Approvals</a>
    <a href={`/cockpit/${caseId}`}>Fleet Cockpit</a>
    <a href={`/audit/${caseId}`}>Audit</a>
  </nav>
  <p class="fs-l-mono" style="margin:0">
    {caseId} · recorded evidence · {liveMode ? 'live mode enabled' : 'static demo'}
  </p>
</footer>
