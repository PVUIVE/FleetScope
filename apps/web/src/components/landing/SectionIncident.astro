---
import SectionHeader from './SectionHeader.astro';
import StatusLabel from './StatusLabel.astro';
import type { LandingData } from '../../lib/landing-data';

/**
 * 05 — Governed recovery (DESIGN.md §20).
 *
 * The one dark surface on the page. Darkness signals deeper operational detail,
 * not a theme change (DESIGN.md §6). Detect → Evaluate → Authorize → Intervene →
 * Verify are five distinct states: "the system fixed it" is not a governance
 * claim, but proposed → authorized → requested → acknowledged → succeeded is.
 */
interface Props {
  data: LandingData;
}
const { data } = Astro.props;

const step = (name: string) =>
  data.interventionLifecycle.find((entry) => entry.state === name) ?? null;

const proposed = step('proposed');
const authorized = step('authorized');
const requested = step('requested');
const acknowledged = step('acknowledged');
const succeeded = step('succeeded');

const steps = [
  {
    n: '01',
    title: 'Detect',
    detail: 'Repeated failure of the same tool crosses a recorded threshold.',
  },
  {
    n: '02',
    title: 'Evaluate',
    detail: 'Policy evaluates the incident and picks one allowlisted action.',
  },
  {
    n: '03',
    title: 'Authorize',
    detail: 'Policy authorizes it. Nothing is authorized by the model.',
  },
  {
    n: '04',
    title: 'Intervene',
    detail: 'The request is issued to the Runtime and acknowledged.',
  },
  {
    n: '05',
    title: 'Verify',
    detail: 'The Runtime reports the authoritative outcome.',
  },
];
---

<section class="fs-l-sec" id="incident" aria-labelledby="fs-l-incident-title">
  <div class="fs-l-scene" data-pin-scene="incident">
    <div class="fs-l-scene__grid">
      <div>
        <SectionHeader num="04" label="Incident + Warden" id="fs-l-incident-title">
          <Fragment slot="headline">Recovery is governed.<br />Not improvised.</Fragment>
        </SectionHeader>
        <ol class="fs-l-steps" style="margin-top:8px">
          {steps.map((entry, index) => (
            <li class="fs-l-step" data-warden-step data-on={index === 0 ? 'true' : 'false'}>
              <span class="fs-l-step__n">{entry.n}</span>
              <div>
                <p class="fs-l-step__t">{entry.title}</p>
                <p class="fs-l-step__d">{entry.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="fs-l-term" data-rise>
        <div class="fs-l-term__head">
          <p class="fs-l-term__title">{data.failingTool ?? 'Runtime'} · operational console</p>
          {data.incidentOpened !== null && (
            <StatusLabel kind="severity" value={data.incidentOpened.severity} />
          )}
        </div>

        {/* Every recorded attempt here failed. The spec's illustrative leading
            success is not in the record, so it is not drawn (DESIGN.md §38). */}
        {data.toolFailures.map((failure) => (
          <div class="fs-l-term__line fs-l-term__line--fail">
            <span>{data.failingTool ?? 'tool'}</span>
            <span aria-hidden="true">✕</span>
            <span class="fs-visually-hidden">failed</span>
            <span class="fs-l-term__evt">{failure.eventId}</span>
            {data.failureClass !== null && <span>{data.failureClass}</span>}
          </div>
        ))}

        {data.incidentOpened !== null && (
          <div class="fs-l-term__group" data-term-group="0" data-on="true">
            <p style="margin:0" class="fs-l-term__evt">incident.detected</p>
            <p style="margin:4px 0 0">
              <span class="fs-l-term__k">class:</span> {data.incidentOpened.incidentClass}
              {data.incidentThreshold !== null && (
                <><br /><span class="fs-l-term__k">threshold:</span> {data.incidentThreshold}</>
              )}
              <br /><span class="fs-l-term__k">evidence:</span> {data.incidentOpened.eventId}
            </p>
          </div>
        )}

        {proposed !== null && (
          <div class="fs-l-term__group" data-term-group="1" data-on="false">
            <p style="margin:0" class="fs-l-term__evt">policy.evaluate</p>
            <p style="margin:4px 0 0">
              <span class="fs-l-term__k">action:</span> {data.interventionTemplate ?? 'bounded action'}
              {data.policyDisposition !== null && (
                <><br /><span class="fs-l-term__k">disposition:</span> {data.policyDisposition}</>
              )}
              <br /><span class="fs-l-term__k">evidence:</span> {proposed.eventId}
            </p>
          </div>
        )}

        {authorized !== null && (
          <div class="fs-l-term__group" data-term-group="2" data-on="false">
            <p style="margin:0" class="fs-l-term__evt">intervention.authorized</p>
            <p style="margin:4px 0 0">
              <span class="fs-l-term__k">by:</span> policy, not the model
              <br /><span class="fs-l-term__k">evidence:</span> {authorized.eventId}
            </p>
          </div>
        )}

        {requested !== null && (
          <div class="fs-l-term__group" data-term-group="3" data-on="false">
            <p style="margin:0" class="fs-l-term__evt">intervention.requested</p>
            {acknowledged !== null && (
              <p style="margin:4px 0 0" class="fs-l-term__evt">runtime.acknowledged</p>
            )}
            <p style="margin:4px 0 0">
              <span class="fs-l-term__k">note:</span> a request is not a result
              <br /><span class="fs-l-term__k">evidence:</span> {requested.eventId}
              {acknowledged !== null && ` · ${acknowledged.eventId}`}
            </p>
          </div>
        )}

        {succeeded !== null && (
          <div class="fs-l-term__group" data-term-group="4" data-on="false">
            <p style="margin:0" class="fs-l-term__evt">runtime.result</p>
            <p class="fs-l-term__result">SUCCEEDED</p>
            <p style="margin:6px 0 0">
              <span class="fs-l-term__k">evidence:</span> {succeeded.eventId}
              {data.incidentResolved !== null && (
                <><br /><span class="fs-l-term__k">incident:</span> {data.incidentResolved.resolution ?? 'resolved'} · {data.incidentResolved.eventId}</>
              )}
            </p>
          </div>
        )}
      </div>
    </div>
  </div>
</section>
