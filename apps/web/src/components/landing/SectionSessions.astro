---
import SectionHeader from './SectionHeader.astro';
import type { LandingData } from '../../lib/landing-data';

/**
 * 02 — One Case, many sessions (DESIGN.md §17).
 *
 * A pinned scene. Scroll advances the active Runtime Session; earlier sessions
 * stay legible but muted, and the simulated gap compresses. Scroll distance is
 * never presented as elapsed time — the gap carries its own recorded figure.
 */
interface Props {
  data: LandingData;
}
const { data } = Astro.props;

/** Spine events belong to the session whose recorded sequence range holds them. */
const eventsFor = (firstSeq: number, lastSeq: number) =>
  data.spine
    .filter((node) => node.caseSequence >= firstSeq && node.caseSequence <= lastSeq)
    .slice(0, 4);
---

<section class="fs-l-sec" id="sessions" aria-labelledby="fs-l-sessions-title">
  <div class="fs-l-scene" data-pin-scene="sessions">
    <div class="fs-l-scene__grid">
      <SectionHeader num="01" label="Long-running operations" id="fs-l-sessions-title">
        <Fragment slot="headline"><span class="fs-l-blue">One Case.</span><br />Weeks of agent work.</Fragment>
        <p class="fs-l-lede">
          {data.eventCount} recorded events across {data.sessionCount} Runtime Sessions, all
          belonging to one business Case.
          {data.simulatedDayBoundary !== null &&
            ` The Runtime resumed at simulated day ${data.simulatedDayBoundary} and the Case carried on where it stopped.`}
        </p>
      </SectionHeader>

      <div class="fs-l-sessions" data-rise>
        {data.sessions.map((session, index) => (
          <>
            <div class="fs-l-session" data-session data-on={index === 0 ? 'true' : 'false'}>
              <div class="fs-l-session__head">
                <p class="fs-l-session__id">Session {String(index + 1).padStart(2, '0')}</p>
                <p class="fs-l-mono" style="margin:0">
                  {session.sessionId} · {session.eventCount} events · seq {session.firstCaseSequence}–{session.lastCaseSequence}
                </p>
              </div>
              <div class="fs-l-spine">
                <span class="fs-l-spine__fill" data-spine-fill aria-hidden="true"></span>
                {eventsFor(session.firstCaseSequence, session.lastCaseSequence).map((node) => (
                  <div class="fs-l-ev" data-tone={node.tone}>
                    <p class="fs-l-ev__label">{node.label}</p>
                    <p class="fs-l-ev__meta">{node.eventId} · seq {node.caseSequence}</p>
                  </div>
                ))}
              </div>
            </div>
            {session.gapDaysToNext !== null && (
              <div class="fs-l-gap" data-gap>
                <span class="fs-l-gap__label">
                  Simulated gap · {session.gapDaysToNext} {session.gapDaysToNext === 1 ? 'day' : 'days'}
                </span>
                <span class="fs-l-mono">No agent is running. The Case is waiting.</span>
              </div>
            )}
          </>
        ))}
      </div>
    </div>
  </div>
</section>
