---
import type { LandingData } from '../../lib/landing-session';

/**
 * 06 — Final CTA.
 *
 * The provenance line is not decoration: it states exactly what was real in the
 * recording this page was built from, so a reader can tell a captured run from
 * a mock-up without taking anyone's word for it.
 */
interface Props {
  data: LandingData;
}
const { data } = Astro.props;
---

<section class="fs-l-sec fs-l-final" aria-labelledby="fs-l-cta-title">
  <h2 id="fs-l-cta-title" class="fs-l-reveal"><span>Debug your next agent visually.</span></h2>
  <div class="fs-l-ctas" data-rise>
    <a class="fs-l-btn fs-l-btn--primary" href="/sessions/">
      Open FleetScope
      <span class="fs-l-btn__arrow" aria-hidden="true">→</span>
    </a>
    <a class="fs-l-btn fs-l-btn--ghost" href="/docs/">Read the setup</a>
  </div>
  <p class="fs-d-provenance" data-rise>{data.provenance}</p>
</section>
