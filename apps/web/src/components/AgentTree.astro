---
/**
 * The agent hierarchy, as DOM.
 *
 * The canvas draws the topology; this makes it readable, keyboard-reachable and
 * copyable. Selecting a node asks the renderer to focus the matching graph node
 * — and only when the renderer ABI actually exposes selection. Where it does
 * not, the node still seeks the Event Cursor to that agent's last recorded
 * action, which is a real capability rather than a pretended one.
 */
import type { AgentNode } from '../lib/agent-tree';
import StatusBadge from './StatusBadge.astro';
import EmptyState from './EmptyState.astro';
import UnknownOr from './UnknownOr.astro';

interface Props {
  nodes: readonly AgentNode[];
}
const { nodes } = Astro.props;
---

<section class="fs-card">
  <div class="fs-section-head">
    <h2>Agent topology</h2>
    <span class="fs-section-head__aside">{nodes.length} agent{nodes.length === 1 ? '' : 's'}</span>
  </div>

  {nodes.length === 0 ? (
    <EmptyState
      title="No agents recorded"
      detail="This evidence prefix contains no agent instance. Nothing was delegated."
    />
  ) : (
    <ul class="fs-tree">
      {nodes.map((node) => (
        <li class={node.depth > 0 ? 'fs-tree__child' : undefined}>
          <button
            type="button"
            class="fs-tree__node"
            data-agent-node={node.agentInstanceId}
            data-case-sequence={node.lastActionCaseSequence ?? ''}
            aria-current="false"
          >
            <span class="fs-tree__name">{node.label}</span>
            <StatusBadge kind="agent" value={node.state} size="sm" />
            <span class="fs-tree__meta">
              {node.agentVersionRef} · {node.sessionId}
            </span>
            <span class="fs-tree__meta">
              {node.toolCallCount} tool call{node.toolCallCount === 1 ? '' : 's'}
              {node.failureCount > 0 && (
                <> · <strong style="color:var(--fs-deny)">{node.failureCount} failed</strong></>
              )}
              {' · '}
              <UnknownOr value={node.outputTokens} suffix=" output tokens" zeroMeans="unknown" />
            </span>
            <span class="fs-tree__meta">
              Last action: {node.lastAction ?? 'Not recorded'}
            </span>
          </button>
        </li>
      ))}
    </ul>
  )}
</section>
