---
import '../styles/global.css';
import Nav from '../components/Nav.astro';

/**
 * The application shell.
 *
 * It provides navigation, the environment chip and the footer disclosure, and
 * nothing else — each route owns its own header through PageHeader, so a page
 * can put badges and actions on the same line as its title instead of paying two
 * rows of chrome for them.
 */
interface Props {
  title: string;
  /** Console surfaces use the full viewport width; documents stay measured. */
  wide?: boolean;
  /** Marks a deferred enterprise surface so the shell says so out loud. */
  legacy?: boolean;
}

const { title, wide = false, legacy = false } = Astro.props;
const path = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title} · FleetScope</title>
  </head>
  <body>
    <div class="fs-shell">
      <!--
        The first Tab stop, so a keyboard user is not made to walk the nav on
        every route before reaching the timeline they came for.
      -->
      <a class="fs-skip" href="#fs-main">Skip to content</a>
      <Nav path={path} legacy={legacy} />
      <main class={wide ? 'fs-main fs-main--wide' : 'fs-main'} id="fs-main">
        <slot />
      </main>
      <footer class="fs-footer">
        <span>FleetScope · local Agent Viewer for Gemini and Google ADK</span>
        <span>
          {legacy
            ? 'This is a deferred enterprise surface, rendered from a recorded fixture. It is not part of the local Agent Viewer.'
            : 'Sessions are captured and stored on this machine only.'}
        </span>
        <span>Third-party attribution in THIRD-PARTY-NOTICES.md</span>
      </footer>
    </div>
  </body>
</html>
