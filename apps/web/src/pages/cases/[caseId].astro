---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UnknownOr from '../../components/UnknownOr.astro';
import {
  getCanonicalEvents,
  getCaseDescriptor,
  listCaseIds,
  projectCase,
} from '../../lib/fixtures';
import {
  answerCaseQuestions,
  milestoneRail,
  recentActivity,
  simulatedDayBoundaries,
} from '../../lib/case-view';

export function getStaticPaths() {
  return listCaseIds().map((caseId) => ({ params: { caseId } }));
}

const { caseId } = Astro.params;
const descriptor = getCaseDescriptor(caseId!);
const events = getCanonicalEvents(caseId!);
const projection = projectCase(caseId!);
const state = projection?.state ?? null;

const answers = state === null ? [] : answerCaseQuestions(state, events);
const rail = state === null ? [] : milestoneRail(state);
const activity = recentActivity(events);
const boundaries = simulatedDayBoundaries(events);
const pendingApprovals = (state?.approvals ?? []).filter((a) => a.state === 'pending');
---

<BaseLayout title={`Case ${caseId}`}>
  <section class="fs-card fs-case-head">
    <div>
      <h2>{caseId} · {descriptor?.vendor}</h2>
      <p class="fs-muted">{descriptor?.title}</p>
    </div>
    <dl class="fs-kv fs-kv--inline">
      <dt>Agent Version</dt><dd class="fs-mono">{descriptor?.agentVersionRef}</dd>
      <dt>Case state</dt><dd><UnknownOr value={state?.caseState} /></dd>
      <dt>Runtime Sessions</dt><dd class="fs-mono">{state?.sessions.length ?? 0}</dd>
      <dt>Owner</dt><dd class="fs-mono">{descriptor?.owner}</dd>
    </dl>
  </section>

  <section class="fs-card" style="margin-bottom:var(--fs-space-4)">
    <h2>Milestones</h2>
    <ul class="fs-milestones">
      {rail.map((step) => (
        <li class="fs-milestone" data-state={step.state}>
          <span aria-hidden="true">{step.state === 'done' ? '✓ ' : step.state === 'current' ? '▸ ' : '· '}</span>
          {step.milestone}
          <span class="fs-visually-hidden">
            {step.state === 'done' ? ' (complete)' : step.state === 'current' ? ' (current)' : ' (not reached)'}
          </span>
        </li>
      ))}
    </ul>
    {boundaries.length > 0 && (
      <p class="fs-muted fs-note">
        {boundaries.map((b) => `Simulated Day ${b.day} · Session ${b.sessionId ?? 'unknown'}`).join(' · ')}
        {' '}— a separate Runtime invocation in the recorded scenario, not elapsed real time.
      </p>
    )}
  </section>

  <section class="fs-card" style="margin-bottom:var(--fs-space-4)">
    <h2>Where this Case stands</h2>
    <div class="fs-answers">
      {answers.map((answer) => (
        <article class="fs-answer">
          <p class="fs-answer__q">{answer.question}</p>
          <p class="fs-answer__a">
            {answer.unknown ? <UnknownOr value={null} /> : answer.answer}
          </p>
          {answer.evidenceEventId !== null && (
            <p class="fs-mono fs-muted" style="margin:var(--fs-space-2) 0 0">
              evidence #{answer.caseSequence} · {answer.evidenceEventId}
            </p>
          )}
        </article>
      ))}
    </div>
  </section>

  <div class="fs-grid fs-grid--2">
    <section class="fs-card">
      <h2>Trusted context</h2>
      <p class="fs-muted fs-note" style="margin-top:0">
        Memory Records are provenance-bearing data, never instructions. Each names
        the Canonical Event it came from.
      </p>
      {(state?.memoryRecords ?? []).length === 0 ? (
        <p class="fs-placeholder">No Memory Records in this evidence prefix.</p>
      ) : (
        <ul class="fs-list">
          {state?.memoryRecords.map((record) => (
            <li>
              <div>{record.summary}</div>
              <div class="fs-mono fs-muted">
                {record.memoryRecordId} · scope {record.scope} · from {record.sourceEventId} ·
                {' '}{record.sensitivity}
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="fs-card">
      <h2>Needs an operator</h2>
      {pendingApprovals.length === 0 ? (
        <p class="fs-placeholder">Nothing is outstanding for an operator.</p>
      ) : (
        <ul class="fs-list">
          {pendingApprovals.map((approval) => (
            <li>
              <div>{approval.actionTemplate} → {approval.target}</div>
              <div class="fs-mono fs-muted">
                bound to evidence #{approval.boundCaseSequence} · expires {approval.expiresAt}
              </div>
            </li>
          ))}
        </ul>
      )}
      <p style="margin:var(--fs-space-3) 0 0"><a href="/approvals">Approval Inbox →</a></p>
    </section>

    <section class="fs-card">
      <h2>Recent activity</h2>
      {activity.length === 0 ? (
        <p class="fs-placeholder">No recorded activity yet.</p>
      ) : (
        <ul class="fs-list">
          {activity.map((row) => (
            <li>
              <div>{row.description}</div>
              <div class="fs-mono fs-muted">
                #{row.caseSequence} · {row.eventId} · {row.sessionId ?? 'case-level'} · {row.at}
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="fs-card">
      <h2>Replay disclosure</h2>
      <dl class="fs-kv fs-kv--tight">
        <dt>Projector version</dt><dd>{state?.projectorVersion}</dd>
        <dt>Event cursor</dt><dd>{state?.cursor.caseSequence}</dd>
        <dt>State hash</dt><dd style="word-break:break-all">{projection?.stateHash}</dd>
        <dt>Invariant violations</dt><dd>{state?.invariantViolations.length ?? 0}</dd>
      </dl>
      <p class="fs-muted fs-note">
        Given the same canonical stream revision, event prefix and projector
        version, FleetScope reconstructs the same Observable Case State.
      </p>
    </section>
  </div>

  <p style="margin-top:var(--fs-space-5);display:flex;gap:var(--fs-space-4)">
    <a href={`/cockpit/${caseId}`}>Open Fleet Cockpit →</a>
    <a href={`/audit/${caseId}`}>Open Audit →</a>
  </p>
</BaseLayout>
