---
import BaseLayout from '../layouts/BaseLayout.astro';
import UnknownOr from '../components/UnknownOr.astro';
import { getAgentVersions, getCaseDescriptor, listCaseIds } from '../lib/fixtures';
import { webConfig } from '../lib/config';

const config = webConfig();
const caseIds = listCaseIds();

/**
 * Registry metadata comes from recorded evidence. FleetScope never invents an
 * approval state or a version — a Catalog entry that showed "Approved" because a
 * Registry was merely reachable would be exactly the badge-without-evidence
 * failure the product forbids.
 */
const versions = getAgentVersions(config.defaultCaseId) as Array<{
  ref: string;
  name: string;
  displayName: string;
  version: string;
  owner: string;
  purpose: string;
  approvalState: string;
  capabilities: string[];
  tools: string[];
  allowedCallers?: string[];
  fleetscopeProtectedSystems?: string[];
  fleetscopeRiskClass?: string;
}>;

/** Which Case, if any, this Agent Version is bound to in recorded evidence. */
const caseForVersion = (ref: string): string | null =>
  caseIds.find((caseId) => getCaseDescriptor(caseId)?.agentVersionRef === ref) ?? null;
---

<BaseLayout title="Agent Catalog">
  <p class="fs-lede">
    Registered Agent Versions, as the Agent Registry recorded them. A Case launched
    from here stays bound to the exact version it started with, whatever the
    Registry publishes afterwards.
  </p>

  <div class="fs-grid fs-grid--2">
    {versions.map((agent) => {
      const boundCase = caseForVersion(agent.ref);
      return (
        <article class="fs-card">
          <header style="display:flex;align-items:baseline;gap:var(--fs-space-3);flex-wrap:wrap">
            <h2 style="color:var(--fs-text);text-transform:none;letter-spacing:0;font-size:16px;margin:0">
              {agent.displayName}
            </h2>
            <span class="fs-badge" data-outcome={agent.approvalState === 'approved' ? 'succeeded' : 'flagged'}>
              <span class="fs-badge__glyph" aria-hidden="true">
                {agent.approvalState === 'approved' ? '✓' : '!'}
              </span>
              {agent.approvalState}
            </span>
            <span class="fs-mono fs-muted">v{agent.version}</span>
          </header>

          <p style="margin-top:var(--fs-space-2)">{agent.purpose}</p>

          <dl class="fs-kv fs-kv--tight">
            <dt>Agent Version</dt><dd>{agent.ref}</dd>
            <dt>Owner</dt><dd>{agent.owner}</dd>
            <dt>Capabilities</dt><dd>{agent.capabilities.join(', ')}</dd>
            <dt>Tools</dt><dd>{agent.tools.join(', ')}</dd>
            <dt>Protected systems</dt>
            <dd>
              {agent.fleetscopeProtectedSystems === undefined ? (
                <UnknownOr value={null} />
              ) : agent.fleetscopeProtectedSystems.length === 0 ? (
                <span>None — this version reaches no protected system</span>
              ) : (
                agent.fleetscopeProtectedSystems.join(', ')
              )}
              <span class="fs-muted"> — FleetScope mapping, not a Registry field</span>
            </dd>
            <dt>Allowed callers</dt>
            <dd><UnknownOr value={agent.allowedCallers?.join(', ')} /></dd>
            <dt>Risk class</dt>
            <dd>
              <UnknownOr value={agent.fleetscopeRiskClass} />
              <span class="fs-muted"> — FleetScope metadata, not a Registry field</span>
            </dd>
          </dl>

          <p style="margin-bottom:0;margin-top:var(--fs-space-4)">
            {boundCase === null ? (
              <span class="fs-muted">No recorded Case is bound to this version.</span>
            ) : (
              <a class="fs-button" data-variant="primary" href={`/cases/${boundCase}`}>
                Start governed case → {boundCase}
              </a>
            )}
          </p>
          {boundCase !== null && (
            <p class="fs-muted fs-note">
              Opens the recorded Case this version was launched with. FleetScope
              starts no new agent run in the recorded demo.
            </p>
          )}
        </article>
      );
    })}
  </div>
</BaseLayout>
