---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ModeBadge from '../components/ModeBadge.astro';
import StatusBadge from '../components/StatusBadge.astro';
import UnknownOr from '../components/UnknownOr.astro';
import CopyableDigest from '../components/CopyableDigest.astro';
import EmptyState from '../components/EmptyState.astro';
import {
  getAgentVersions,
  getCanonicalEvents,
  getCaseDescriptor,
  listCaseIds,
} from '../lib/fixtures';

/**
 * Governed agent discovery.
 *
 * Registry metadata comes from recorded evidence. FleetScope never invents an
 * approval state, a digest or a version — a Catalog entry that showed "Approved"
 * because a Registry was merely reachable would be exactly the
 * badge-without-evidence failure the product forbids (Invariant 6).
 */

const caseIds = listCaseIds();

interface CatalogAgent {
  ref: string;
  name: string;
  displayName: string;
  version: string;
  owner: string;
  purpose: string;
  approvalState: string;
  capabilities: string[];
  tools: string[];
  allowedCallers?: string[];
  publishedAt?: string;
  fleetscopeProtectedSystems?: string[];
  fleetscopeRiskClass?: string;
}

// Versions are recorded per Case; the Catalog is the union across every Case in
// this build, so adding a second recorded Case adds its agents here too.
const versions = new Map<string, CatalogAgent>();
for (const caseId of caseIds) {
  for (const agent of getAgentVersions(caseId) as CatalogAgent[]) {
    if (!versions.has(agent.ref)) versions.set(agent.ref, agent);
  }
}
// Launchable first. A version bound to a recorded Case is the thing an operator
// came here to start; an orchestrated dependency is context. Neither position is
// hard-coded — the ordering is read from the recorded Case bindings below.
const agents = [...versions.values()];

/** The digest the Registry actually resolved, read off the canonical stream. */
const digestFor = new Map<string, string>();
for (const caseId of caseIds) {
  for (const event of getCanonicalEvents(caseId)) {
    if (event.type !== 'registry.version_resolved') continue;
    const ref = event.correlations['agentVersionRef'];
    const digest = event.payloadRedacted['digest'];
    if (typeof ref === 'string' && typeof digest === 'string') digestFor.set(ref, digest);
  }
}

/** Which recorded Case, if any, this Agent Version is bound to. */
const caseForVersion = (ref: string): string | null =>
  caseIds.find((caseId) => getCaseDescriptor(caseId)?.agentVersionRef === ref) ?? null;

agents.sort((a, b) => {
  const bound = Number(caseForVersion(b.ref) !== null) - Number(caseForVersion(a.ref) !== null);
  return bound !== 0 ? bound : a.displayName.localeCompare(b.displayName);
});
---

<BaseLayout title="Agent Catalog" legacy>
  <PageHeader
    title="Agent Catalog"
    lede="Approved Agent Versions you can launch a governed Case from. A Case stays bound to the exact version it started with, whatever the Registry publishes afterwards."
  >
    <ModeBadge slot="badges" mode="recorded" />
  </PageHeader>

  {agents.length === 0 ? (
    <EmptyState
      title="No Agent Versions recorded"
      detail="This build contains no Registry evidence. Nothing can be launched from here."
    />
  ) : (
    <div class="fs-grid fs-grid--2">
      {agents.map((agent) => {
        const boundCase = caseForVersion(agent.ref);
        return (
          <article class="fs-card">
            <div class="fs-section-head">
              <h3 class="fs-title">{agent.displayName}</h3>
              <span class="fs-mono fs-muted">v{agent.version}</span>
              <StatusBadge
                kind="control"
                value={agent.approvalState === 'approved' ? 'allowed' : 'flagged'}
                label={agent.approvalState === 'approved' ? 'Approved' : agent.approvalState}
              />
            </div>

            <p style="margin:0 0 var(--fs-space-3)">{agent.purpose}</p>

            <dl class="fs-kv fs-kv--tight">
              <dt>Agent Version</dt><dd class="fs-mono">{agent.ref}</dd>
              <dt>Owner</dt><dd class="fs-mono">{agent.owner}</dd>
              <dt>Risk class</dt>
              <dd>
                <UnknownOr value={agent.fleetscopeRiskClass} />
                <span class="fs-faint"> — FleetScope metadata, not a Registry field</span>
              </dd>
              <dt>Capabilities</dt><dd class="fs-mono">{agent.capabilities.join(' · ')}</dd>
              <dt>Tools</dt><dd class="fs-mono">{agent.tools.join(' · ')}</dd>
              <dt>Allowed callers</dt>
              <dd class="fs-mono"><UnknownOr value={agent.allowedCallers?.join(' · ')} /></dd>
              <dt>Protected systems</dt>
              <dd>
                {agent.fleetscopeProtectedSystems === undefined ? (
                  <UnknownOr value={null} />
                ) : agent.fleetscopeProtectedSystems.length === 0 ? (
                  <span>None — this version reaches no protected system</span>
                ) : (
                  <span class="fs-mono">{agent.fleetscopeProtectedSystems.join(' · ')}</span>
                )}
                <span class="fs-faint"> — FleetScope mapping, not a Registry field</span>
              </dd>
              <dt>Last published</dt>
              <dd class="fs-mono"><UnknownOr value={agent.publishedAt} /></dd>
              <dt>Version digest</dt>
              <dd>
                <CopyableDigest value={digestFor.get(agent.ref)} label="version digest" />
                {digestFor.get(agent.ref) === undefined && (
                  <span class="fs-faint"> — no Registry resolution is recorded for this version</span>
                )}
              </dd>
            </dl>

            <div class="fs-link-row" style="margin-top:var(--fs-space-4)">
              {boundCase === null ? (
                <span class="fs-muted" style="font-size:12px">
                  No recorded Case is bound to this version.
                </span>
              ) : (
                <>
                  <a class="fs-button" data-variant="primary" href={`/cases/${boundCase}`}>
                    Open Recorded Case · {boundCase}
                  </a>
                  <a class="fs-button" href={`/audit/${boundCase}`}>View version evidence</a>
                </>
              )}
            </div>
            {boundCase !== null && (
              <p class="fs-note">
                Opens the recorded Case this version was launched with. FleetScope
                starts no new agent run in the recorded demo — the button says so
                rather than pretending a Case was provisioned.
              </p>
            )}
          </article>
        );
      })}
    </div>
  )}
</BaseLayout>
