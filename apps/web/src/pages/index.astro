---
import LandingLayout from '../layouts/LandingLayout.astro';
import Hero from '../components/landing/Hero.astro';
import SectionLogsToGraph from '../components/landing/SectionLogsToGraph.astro';
import SectionExecutionEvents from '../components/landing/SectionExecutionEvents.astro';
import SectionFailure from '../components/landing/SectionFailure.astro';
import SectionReplay from '../components/landing/SectionReplay.astro';
import SectionCta from '../components/landing/SectionCta.astro';
import { landingSession } from '../lib/landing-session';

/**
 * The public landing page.
 *
 * Six sections, one promise: see what your agents are doing. Every figure below
 * is read at BUILD time out of a REAL recorded Google ADK run
 * (`packages/fixtures/sessions/vendor-onboarding`), so the page cannot claim
 * something the product did not capture.
 */
const data = landingSession();
---

<LandingLayout
  title="FleetScope — see what your agents are doing"
  description="FleetScope is a local Agent Viewer for Gemini and Google ADK that turns agent sessions into a live execution graph and inspectable timeline."
  sessionId={data.sessionId}
>
  <Hero data={data} />
  <SectionLogsToGraph data={data} />
  <SectionExecutionEvents data={data} />
  <SectionFailure data={data} />
  <SectionReplay data={data} />
  <SectionCta data={data} />
</LandingLayout>

<script>
  import '../scripts/landing.ts';
</script>
