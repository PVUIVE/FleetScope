server {
  listen ${PORT};
  listen [::]:${PORT};
  server_name _;
  # Keep redirect targets relative so Railway's reverse proxy cannot expose its internal port.
  absolute_redirect off;

  root /usr/share/nginx/html;
  index index.html;

  location = /health {
    default_type text/plain;
    return 200 "ok\n";
  }

  # `/` is the landing page (apps/web/src/pages/index.astro), served by the
  # `location /` block below. It was previously redirected to /cases/, which
  # predated the landing page and sent every visitor to the deferred enterprise
  # surface instead of the product — see apps/web/src/deferred/README.md.

  location ^~ /_astro/ {
    try_files $uri =404;
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location ~* \.wasm$ {
    try_files $uri =404;
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location / {
    try_files $uri $uri/ $uri/index.html =404;
  }
}
